---
// Signature (concept §5): the inverted triangle of yellow stripes from the CARDON logo.
// Each stripe is its own <polygon> so it can be scaled in from the centre (motion effect 1).
interface Props { class?: string; count?: number; }
const { class: cls, count = 5 } = Astro.props;
const W = 480, H = 420, step = 86, band = 56;
const half = (y: number) => (W / 2) * (1 - y / H);
const stripes = Array.from({ length: count }, (_, i) => {
  const y0 = i * step, y1 = y0 + band;
  const pts = [
    [W / 2 - half(y0), y0], [W / 2 + half(y0), y0],
    [W / 2 + half(y1), y1], [W / 2 - half(y1), y1],
  ].map(([x, y]) => `${x.toFixed(1)},${y}`).join(" ");
  return pts;
});
const vh = (count - 1) * step + band;
---
<svg class:list={["stripes", cls]} viewBox={`0 0 ${W} ${vh}`} aria-hidden="true" focusable="false">
  {stripes.map((p, i) => <polygon class="stripes__s" points={p} style={`--i:${i}`} />)}
</svg>
